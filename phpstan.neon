includes:
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - src
        # Static-analysis fixtures: type-level regression guards analysed
        # exactly like a consumer app would be (e.g. a Resource returning
        # layout wrappers from fields()). Kept out of src so they don't ship.
        - tests/StaticAnalysis
    # Baseline locks the pre-v1 errors (220 at the v1.0.0 cut, 189 entries
    # in phpstan-baseline.neon at v1.39.0) so CI fails on new errors. Track
    # the count down to zero; regenerating also drops stale entries:
    #   vendor/bin/phpstan analyse --memory-limit=2G --generate-baseline=phpstan-baseline.neon
    #
    # `reportUnmatchedIgnoredErrors: false` keeps inline `@phpstan-ignore-*`
    # comments tolerant — when the underlying error gets fixed the comment
    # becomes silent rather than triggering a new failure.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            identifier: trait.unused
            path: src/Concerns/Actionable.php
        -
            # Public-API trait for consumer Tools (used via `use ProvidesToolFields`
            # in downstream apps), so it is never referenced inside the package.
            identifier: trait.unused
            path: src/Concerns/ProvidesToolFields.php
        -
            identifier: property.notFound
            path: src/Profile/TwoFactorService.php
