import {useState, type FormEvent} from 'react'
import {
  useTranslation,
  useAuth,
  useToast,
  api,
  ApiError,
  AuthFrame,
  config,
} from '@martis/runtime'

/**
 * {{ class }}: custom forced password change page override.
 *
 * Auto-discovery convention (v1.9.0+): lives at
 * `resources/js/martis-extensions/overrides/PasswordChangePage.tsx`,
 * registered under `auth:password-change`. Rendered at `/password/change`
 * when `martis.auth.password_change.enabled=true` and the signed-in user
 * must choose a new password (v2.3.0).
 *
 * Reference implementation: `vendor/martis/martis/resources/js/pages/PasswordChangeRequired.tsx`.
 */
export default function {{ class }}() {
  const { logout } = useAuth()
  const { addToast } = useToast()
  const { t } = useTranslation('auth')

  const [current, setCurrent] = useState('')
  const [password, setPassword] = useState('')
  const [confirmation, setConfirmation] = useState('')
  const [errors, setErrors] = useState<Record<string, string>>({})
  const [submitting, setSubmitting] = useState(false)

  async function handleSubmit(e: FormEvent) {
    e.preventDefault()
    setErrors({})
    setSubmitting(true)
    try {
      await api.post('/api/auth/password/change', {
        current_password: current,
        password,
        password_confirmation: confirmation,
      })
      window.location.href = (config.basePath ?? '/martis') + '/'
    } catch (err) {
      if (err instanceof ApiError && err.status === 422) {
        setErrors(err.errorsByField())
      } else {
        addToast('error', err instanceof Error ? err.message : t('error'))
      }
      setSubmitting(false)
    }
  }

  return (
    <AuthFrame>
      <h2 className="martis-auth-title">
        {/* TODO: customise the headline */}
        {t('password_change_title', { defaultValue: 'Choose a new password' })}
      </h2>

      <form onSubmit={(e) => void handleSubmit(e)} noValidate style={{ marginTop: 24 }}>
        <label htmlFor="current_password" className="martis-label">
          {t('password_change_current', { defaultValue: 'Current password' })}
        </label>
        <input
          id="current_password"
          type="password"
          autoComplete="current-password"
          value={current}
          onChange={(e) => setCurrent(e.target.value)}
          className="martis-input"
          required
        />
        {errors.current_password && <p className="martis-field-error">{errors.current_password}</p>}

        <label htmlFor="password" className="martis-label" style={{ marginTop: 12 }}>
          {t('password_change_new', { defaultValue: 'New password' })}
        </label>
        <input
          id="password"
          type="password"
          autoComplete="new-password"
          value={password}
          onChange={(e) => setPassword(e.target.value)}
          className="martis-input"
          required
        />
        {errors.password && <p className="martis-field-error">{errors.password}</p>}

        <label htmlFor="password_confirmation" className="martis-label" style={{ marginTop: 12 }}>
          {t('password_change_confirm', { defaultValue: 'Confirm new password' })}
        </label>
        <input
          id="password_confirmation"
          type="password"
          autoComplete="new-password"
          value={confirmation}
          onChange={(e) => setConfirmation(e.target.value)}
          className="martis-input"
          required
        />

        <button type="submit" className="martis-btn-primary" style={{ width: '100%', height: 40, marginTop: 16 }} disabled={submitting}>
          {t('password_change_submit', { defaultValue: 'Save new password' })}
        </button>
      </form>

      <button
        type="button"
        onClick={() => void logout()}
        className="martis-btn-secondary"
        style={{ width: '100%', height: 40, marginTop: 8, justifyContent: 'center' }}
      >
        {t('password_change_sign_out', { defaultValue: 'Sign out' })}
      </button>
    </AuthFrame>
  )
}
