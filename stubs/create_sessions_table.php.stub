        $shapes = [];
        foreach ($this->resolveUserModels() as $model) {
            $shapes[$this->keyShape($model)] = true;
        }

        if ($shapes === []) {
            return 'bigint';
        }

        // The users of the guards disagree on the key (an `admins` guard
        // keyed by UUID beside the site's bigint `users`): only a string
        // column holds both, where either typed column rejects the other
        // guard's ids on PostgreSQL and MySQL.
        return count($shapes) === 1 ? (string) array_key_first($shapes) : 'string';
