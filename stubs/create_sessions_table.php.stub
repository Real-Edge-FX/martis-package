        $table = config('session.table', 'sessions');

        if (Schema::hasTable($table)) {
            return;
        }

        $userKey = $this->resolveUserKey();

        Schema::create($table, function (Blueprint $blueprint) use ($userKey) {
            $blueprint->string('id')->primary();

            match ($userKey) {
                'uuid' => $blueprint->uuid('user_id')->nullable()->index(),
                'ulid' => $blueprint->ulid('user_id')->nullable()->index(),
                'string' => $blueprint->string('user_id')->nullable()->index(),
                default => $blueprint->foreignId('user_id')->nullable()->index(),
            };

            $blueprint->string('ip_address', 45)->nullable();
            $blueprint->text('user_agent')->nullable();
            $blueprint->longText('payload');
            $blueprint->integer('last_activity')->index();
        });
    }

    public function down(): void
