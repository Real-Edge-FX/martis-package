# OS / editor
.DS_Store
.idea/
.codex/
.claude/

# Local environment
.env
.env.*
!.env.example

# Dependencies
# No trailing slash: also ignores a `node_modules` symlink (a git worktree
# linking the main checkout's dependencies).
node_modules
# Anchored to the root: an unanchored `vendor/` (or `coverage/`,
# `internal/`) also ignores a source directory of that name at any
# depth, case-insensitively on macOS (the vendored PrimeReact SASS
# source had to move from `vendor/` to `upstream/` for that reason).
/vendor/

# Test / tooling cache
.phpunit.result.cache
/coverage/
/coverage-*/
test-results/

# Vite / logs
public/hot
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Misc
*.tmp
*.temp
*.swp
*.swo
docs/superpowers/
.superpowers/
.claude-flow/

# Internal-only dev docs — never publish to the public package repo
/internal/
